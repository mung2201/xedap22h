NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/bike_store?replicaSet=rs0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Replace all JWT values with long, unique secrets before deployment.
JWT_ACCESS_SECRET=replace-this-with-a-long-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-long-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
# Use `none` only with COOKIE_SECURE=true when frontend and API are on different sites.
COOKIE_SAME_SITE=lax
BCRYPT_SALT_ROUNDS=12

# Password reset
RESET_PASSWORD_EXPIRES_MINUTES=60

# Checkout pricing is configured here, never accepted from the frontend.
SHIPPING_STANDARD_FEE=30000
SHIPPING_EXPRESS_FEE=50000
FREE_SHIPPING_MIN_ORDER=0
# Demo 1k-only carts automatically have free shipping; no extra flag is needed.
LOW_STOCK_THRESHOLD=5

# Online payment: QR_TRANSFER preserves the existing SANDBOX/VIETQR flow.
# Select PAYOS or MOMO after filling in the corresponding merchant credentials.
ONLINE_PAYMENT_PROVIDER=QR_TRANSFER

# payOS QR bank transfer: production payment channel, not a sandbox.
# Fill in fresh credentials from your payOS channel, only on the backend.
# With missing keys in development, payOS is disabled while COD remains usable.
# Production startup requires all three keys when PAYOS is selected.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PAYMENT_EXPIRES_MINUTES=30
# Register https://your-api.example.com/api/v1/payments/payos/webhook in payOS.
# Browser return URLs are not payment confirmation; verified webhook/status is used.

# MoMo Business: keep credentials on the server; never use VITE_ variables.
# sandbox uses test-payment.momo.vn; production uses payment.momo.vn.
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Public HTTPS callback, for example https://api.example.com/api/v1/payments/momo/ipn
# Localhost is not reachable by MoMo. Use a public backend or a development tunnel.
MOMO_IPN_URL=

# QR transfer payment
# SANDBOX: a test QR and a safe demo-confirmation button.
# VIETQR: a real bank-transfer QR. The banking app deducts money; automatic
# order confirmation then requires a verified gateway/bank webhook.
PAYMENT_QR_MODE=SANDBOX
PAYMENT_QR_BANK_BIN=
PAYMENT_QR_ACCOUNT_NO=
PAYMENT_QR_ACCOUNT_NAME=
PAYMENT_QR_TEMPLATE=compact2
PAYMENT_QR_CONTENT_PREFIX=BIKESTORE

# Image uploads are stored locally for development. Do not commit backend/uploads.
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_SIZE_MB=5

# Mail: development preview logging must never be enabled in production.
# Production startup requires SMTP_HOST, SMTP_USER, and SMTP_PASSWORD.
MAIL_PREVIEW_MODE=true
MAIL_FROM=Cửa hàng xe đạp 22h <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Seed data. Change these before any shared deployment.
SEED_ADMIN_PASSWORD=123456789
SEED_STAFF_PASSWORD=1234567899
SEED_CUSTOMER_PASSWORD=12345678999
